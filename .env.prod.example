# Wzór pliku .env.prod dla docker-compose.prod.yml. Skopiuj do .env.prod i uzupełnij.
# Plik .env.prod trzymaj tylko na serwerze — nigdy w repozytorium.
# Losowe wartości: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Lokalnie ":80". Na serwerze sama domena, np. pachniemilo.pl (Caddy weźmie certyfikat HTTPS).
SITE_ADDRESS=:80
# Adres sklepu: lokalnie http://localhost, na serwerze https://twojadomena.pl
FRONTEND_URL=http://localhost

POSTGRES_PASSWORD=zmien-na-dlugie-losowe-haslo

# Klucze z panelu Stripe. Na serwerze webhook z Developers → Webhooks dla https://<domena>/api/webhooks/stripe.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Panel /admin (login: admin): hasło min. 16 znaków, klucz min. 32. Inne niż lokalne.
ADMIN_PASSWORD=zmien-na-dlugie-losowe-haslo
ADMIN_SECRET_KEY=zmien-na-dlugi-losowy-klucz

RESEND_API_KEY=
MAIL_FROM=Pachnie miło <sklep@twojadomena.pl>
SHOP_OWNER_EMAIL=ty@twojadomena.pl
