{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run pytest)",
      "Bash(uv run ruff *)",
      "Bash(uv sync)",
      "Bash(uv add *)",
      "Bash(uv run alembic revision *)",
      "Bash(uv run alembic upgrade head)",
      "Bash(npm test *)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm install *)",
      "Bash(npx vitest *)",
      "Bash(docker compose up -d db)",
      "Bash(docker compose ps)",
      "Bash(stripe trigger *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git add *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(uv run alembic downgrade *)",
      "Bash(railway *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./backend/.env)",
      "Read(./backend/.env.local)",
      "Read(./backend/.env.production)",
      "Read(./frontend/.env)",
      "Read(./frontend/.env.local)",
      "Read(./frontend/.env.production)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  }
}
